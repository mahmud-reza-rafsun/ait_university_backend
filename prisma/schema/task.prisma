model Task {
    id          String  @id @default(uuid())
    question    String
    description String?

    lessonId String
    lesson   Lesson @relation(fields: [lessonId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    submissions TaskSubmission[]

    @@index([lessonId])
    @@map("task")
}
